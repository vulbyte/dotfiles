        {
            "prev_ver": 537001986,
            "name": "Browser",
            "uuid": "45c322bb-39d2-43ba-8355-3e70e7c0f5d5",
            "id": "browser_source",
            "versioned_id": "browser_source",
            "settings": {
                "url": "www.youtube.com/live_chat?is_popout=1&v=t17PTIRZPbY",
                "width": 1024,
                "height": 2048,
                "restart_when_active": false,
                "css": "body { \n\tbackground-image: transparent; \n\tmargin: 0px auto; \n\toverflow: hidden; \n}\ntp-yt-iron-pages {display: none;}\nyt-live-chat-viewer-engagement-message-renderer {display: none;}\n\n#chat {\n  /* Base background color to anchor the blend mode */\n  background-color: #1a0005;\n  \n  /* Stacked backgrounds: your original gradient + the local file via file:// protocol */\n  background-image: \n    linear-gradient(to bottom, #000000, #ffff00, #00ffff),\n    url('https://blenderartists.org/uploads/default/original/4X/8/3/f/83f102d07d76f5c7ea97bd0d304cdb221811fe7e.png');\n\n  /* Repeat the PNG texture and size it to 500px square */\n  background-repeat: repeat, repeat;\n  background-size: auto, 1000px, 1000px;\n\n  /* Blend the noise with your gradient */\n  background-blend-mode: lighten ;\n\n  /* Infinite vertical slide loop */\n  animation: slideNoise 10s linear infinite;\n}\n\n@keyframes slideNoise {\n  0% {\n    background-position: 0px 0px, 0px 0px;\n  }\n  100% {\n    /* Shifts the noise layer vertically by -500px to match its height */\n    background-position: 0px 0px, 0px -500px;\n  }\n}\n\nyt-live-chat-text-message-renderer {\n\tbackground-color: black;\n\tborder-radius: 1rem;\n\tmargin-bottom: 1rem;\n\tmargin-left: 2rem;\n}"
            },
            "mixers": 255,
            "sync": 0,
            "flags": 0,
            "volume": 1.0,
            "balance": 0.5,
            "enabled": true,
            "muted": false,
            "push-to-mute": false,
            "push-to-mute-delay": 0,
            "push-to-talk": false,
            "push-to-talk-delay": 0,
            "hotkeys": {
