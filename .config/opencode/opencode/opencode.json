{
  "$schema": "https://opencode.ai/config.json",

  // 1. Set Qwen as your default model
  "model": "lmstudio/qwen/qwen2.5-coder-14b",

  // 2. Define the LM Studio provider and point to your local IP
  "providers": {
    "lmstudio": {
      "settings": {
        // Appending /v1 is mandatory for OpenAI-compatible endpoints
        "baseURL": "http://192.168.1:1234" 
      },
      "models": {
        "qwen/qwen2.5-coder-14b": {
          "name": "Qwen 2.5 Coder 14B"
        }
      }
    }
  },

  // 3. Grant explicit tool permissions to let the agent work autonomously
  "tools": {
    "bash": true,
    "edit": true,
    "write": true,
    "read": true
  }
}
